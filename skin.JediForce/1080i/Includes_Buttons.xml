<includes>
	<include name="OSDButton">
		<param name="texture" default="" />
		<param name="texture_focus" default="$PARAM[texture]" />
		<param name="texture_nofocus" default="$PARAM[texture]" />
		<definition>
			<textureradioonfocus colordiffuse="white">$PARAM[texture_focus]</textureradioonfocus>
			<textureradioonnofocus>$PARAM[texture_nofocus]</textureradioonnofocus>
			<textureradioofffocus colordiffuse="white">$PARAM[texture_focus]</textureradioofffocus>
			<textureradiooffnofocus>$PARAM[texture_nofocus]</textureradiooffnofocus>
			<textureradioondisabled colordiffuse="disabled">$PARAM[texture_nofocus]</textureradioondisabled>
			<textureradiooffdisabled colordiffuse="disabled">$PARAM[texture_nofocus]</textureradiooffdisabled>
			<!-- DSTV: colordiffuse. -->
			<texturefocus colordiffuse="selected">dstv/osd/button-fo.png</texturefocus>
			<width>65</width>
			<animation center="38,38" effect="zoom" end="100" reversible="false" start="95" time="480" tween="back">Focus</animation>
			<height>65</height>
			<radiowidth>65</radiowidth>
			<radioheight>65</radioheight>
			<font></font>
			<texturenofocus />
			<radioposx>1</radioposx>
			<radioposy>0</radioposy>
		</definition>
	</include>
