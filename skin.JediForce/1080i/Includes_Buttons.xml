	<include name="InfoDialogButton">
		<param name="width">250</param>
		<param name="onclick_1_condition">true</param>
		<param name="onclick_2_condition">true</param>
		<param name="onclick_3_condition">true</param>
		<param name="onclick_4_condition">false</param>
		<param name="onclick_5_condition">false</param>
		<param name="onclick_6_condition">false</param>
		<param name="onclick_7_condition">false</param>
		<param name="onclick_8_condition">false</param>
		<param name="visible">true</param>
		<param name="onup_condition">false</param>
		<param name="onup"></param>
		<definition>
			<control type="radiobutton" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<height>142</height>
				<align>center</align>
				<aligny>top</aligny>
				<texturefocus border="21" colordiffuse="button_focus">buttons/button-fo.png</texturefocus>
				<texturenofocus border="21">buttons/button-nofo.png</texturenofocus>
				<textoffsetx>22</textoffsetx>
				<textoffsety>78</textoffsety>
				<radioposx>101</radioposx>
				<radioposy>16</radioposy>
				<radiowidth>48</radiowidth>
				<font>font12</font>
				<!-- DSTV: background. -->
				<focusedcolor>background</focusedcolor>
				<textureradioonfocus colordiffuse="D0FFFFFF">$PARAM[icon]</textureradioonfocus>
				<textureradioonnofocus colordiffuse="D0FFFFFF">$PARAM[icon]</textureradioonnofocus>
				<textureradioofffocus colordiffuse="D0FFFFFF">$PARAM[icon]</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="D0FFFFFF">$PARAM[icon]</textureradiooffnofocus>
				<textureradiooffdisabled colordiffuse="disabled">$PARAM[icon]</textureradiooffdisabled>
				<textureradioondisabled colordiffuse="disabled">$PARAM[icon]</textureradioondisabled>
				<label>$PARAM[label]</label>
				<onclick condition="$PARAM[onclick_1_condition]">$PARAM[onclick_1]</onclick>
				<onclick condition="$PARAM[onclick_2_condition]">$PARAM[onclick_2]</onclick>
				<onclick condition="$PARAM[onclick_3_condition]">$PARAM[onclick_3]</onclick>
				<onclick condition="$PARAM[onclick_4_condition]">$PARAM[onclick_4]</onclick>
				<onclick condition="$PARAM[onclick_5_condition]">$PARAM[onclick_5]</onclick>
				<onclick condition="$PARAM[onclick_6_condition]">$PARAM[onclick_6]</onclick>
				<onclick condition="$PARAM[onclick_7_condition]">$PARAM[onclick_7]</onclick>
				<onclick condition="$PARAM[onclick_8_condition]">$PARAM[onclick_8]</onclick>
				<onup condition="$PARAM[onup_condition]">$PARAM[onup]</onup>
				<onfocus condition="String.IsEqual($PARAM[id],444) + !String.IsEmpty(Window.Property(ds_dialog_tmdb_id))">SetProperty(ds_pov_show_related,true)</onfocus>
				<onunfocus condition="String.IsEqual($PARAM[id],444) + !String.IsEmpty(Window.Property(ds_pov_show_related)) + String.IsEmpty(Window.Property(ds_pov_keep_related))">ClearProperty(ds_pov_show_related)</onunfocus>
				<onleft condition="String.IsEqual($PARAM[id],444)">ClearProperty(ds_pov_keep_related)</onleft>
				<onleft condition="String.IsEqual($PARAM[id],444)">ClearProperty(ds_pov_show_related)</onleft>
				<onleft condition="String.IsEqual($PARAM[id],444)">443</onleft>
				<onright condition="String.IsEqual($PARAM[id],444)">SetProperty(ds_pov_show_related,true)</onright>
				<onright condition="String.IsEqual($PARAM[id],444)">SetProperty(ds_pov_keep_related,true)</onright>
				<onright condition="String.IsEqual($PARAM[id],444) + Control.IsVisible(98181)">SetFocus(98181,0,absolute)</onright>
				<onright condition="String.IsEqual($PARAM[id],444) + Control.IsVisible(98183)">SetFocus(98183,0,absolute)</onright>
				<onright condition="String.IsEqual($PARAM[id],441) + !String.IsEmpty(Window.Property(ds_dialog_tmdb_id))">SetProperty(ds_pov_show_related,true)</onright>
				<onright condition="String.IsEqual($PARAM[id],441) + !String.IsEmpty(Window.Property(ds_dialog_tmdb_id))">SetProperty(ds_pov_keep_related,true)</onright>
				<onright condition="String.IsEqual($PARAM[id],441) + String.IsEqual(Window.Property(ds_dialog_tmdb_type),movie)">SetFocus(98181,0,absolute)</onright>
				<onright condition="String.IsEqual($PARAM[id],441) + String.IsEqual(Window.Property(ds_dialog_tmdb_type),tv)">SetFocus(98183,0,absolute)</onright>
				<ondown condition="String.IsEqual($PARAM[id],444)">ClearProperty(ds_pov_keep_related)</ondown>
				<ondown condition="String.IsEqual($PARAM[id],444)">ClearProperty(ds_pov_show_related)</ondown>
				<ondown condition="String.IsEqual($PARAM[id],444) + Control.IsVisible(50)">SetFocus(50,0)</ondown>
				<ondown condition="String.IsEqual($PARAM[id],444) + !Control.IsVisible(50)">140</ondown>
				<visible>$PARAM[visible]</visible>
				<animation effect="fade" start="100" end="0" time="300" delay="300">Hidden</animation>
			</control>
		</definition>
	</include>
